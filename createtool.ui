         <property name="title"><string>实验室预测服务</string></property>
         <layout class="QFormLayout" name="predictionServiceLayout">
          <property name="fieldGrowthPolicy"><enum>QFormLayout::AllNonFixedFieldsGrow</enum></property>
          <item row="0" column="0"><widget class="QLabel" name="predictionServiceUrlLabel"><property name="text"><string>服务地址</string></property><property name="buddy"><cstring>predictionServiceUrlLineEdit</cstring></property></widget></item>
          <item row="0" column="1"><widget class="QLineEdit" name="predictionServiceUrlLineEdit"><property name="text"><string>http://127.0.0.1:8000</string></property><property name="toolTip"><string>填写实验室服务地址；使用 SSH 隧道时填写本机转发地址。</string></property></widget></item>
          <item row="1" column="0"><widget class="QLabel" name="predictionTokenLabel"><property name="text"><string>访问密钥</string></property><property name="buddy"><cstring>predictionTokenLineEdit</cstring></property></widget></item>
          <item row="1" column="1"><widget class="QLineEdit" name="predictionTokenLineEdit"><property name="echoMode"><enum>QLineEdit::Password</enum></property><property name="toolTip"><string>填写实验室服务的 SPT_API_TOKEN；密钥仅在本次会话中使用。</string></property></widget></item>
          <item row="2" column="0" colspan="2"><widget class="QPushButton" name="predictionConnectButton"><property name="text"><string>测试连接</string></property></widget></item>
